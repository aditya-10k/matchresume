# ==============================================================================
# MatchResume - Frontend Environment Configuration
# ==============================================================================

# Backend API Endpoint
# Points to local FastAPI server during development or your deployed backend (e.g. Render / Railway)
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Production Canonical Site URL (Used for sitemaps, robots.txt, and metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Permitted LLM Models (Displayed in the UI Model Selector)
# You can specify a comma-separated list in NEXT_PUBLIC_GROQ_MODELS or individual slots below:
NEXT_PUBLIC_GROQ_MODELS="openai/gpt-oss-120b,llama-3.3-70b-versatile,qwen/qwen3-32b"
NEXT_PUBLIC_MODEL_1="openai/gpt-oss-120b"
NEXT_PUBLIC_MODEL_2="llama-3.3-70b-versatile"
NEXT_PUBLIC_MODEL_3="qwen/qwen3-32b"
