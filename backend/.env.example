# App Configuration
APP_NAME=Resume Copilot API
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL supported; SQLite supported for local dev)
DATABASE_URL=sqlite:///./matchresume.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchresume

# LLM Configuration (Groq)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# RAG Configuration
CHROMA_PERSIST_DIR=./chroma_data

