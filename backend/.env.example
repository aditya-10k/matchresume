# ==============================================================================
# MatchResume - Backend Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="Resume Copilot API"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Database Configuration
# Use SQLite for quick local development or PostgreSQL for production:
# DATABASE_URL=postgresql://user:password@localhost:5432/matchresume
DATABASE_URL="sqlite:///./matchresume.db"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "https://matchresume.web.app"]

# Primary LLM Provider: Groq (console.groq.com)
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Failover LLM Provider: OpenRouter (openrouter.ai)
# Automatic failover upon encountering HTTP 429 rate limits or provider downtime
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# Security & Authentication
JWT_SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Symmetric Encryption Key for BYOK credentials (generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY="yR7gU_0wz3D5P9L6F2M8A4Q1J5X8T7K2N4V0Z3C6E9A="

# ChromaDB Semantic Vector Storage Directory
CHROMA_PERSIST_DIR="./chroma_data"
